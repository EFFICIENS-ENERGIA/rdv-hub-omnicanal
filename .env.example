# ==============================================================================
# 🔐 RDV-HUB SAAS -- MODELE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# Copiez ce fichier sous le nom ".env" et ajustez vos parametres de deploiement.
# ==============================================================================

# --- ENVIRONNEMENT & NOM DU PROJET ---
APP_NAME="RDV-Hub Omnicanal SaaS"
APP_ENV=production
APP_DEBUG=false
DOMAIN_NAME=mon-rdv-hub.fr
LETSENCRYPT_EMAIL=sebastien.pro@gmail.com
SSL_ENABLED=true

# --- PORTS ET RESEAU DOCKER ---
# Port expose sur votre machine hote (ex: http://localhost:8092)
HOST_PORT=8092

# Port interne du Reverse Proxy Nginx
PROXY_PORT=80

# Port interne du conteneur applicatif Web (Non-root)
WEB_APP_PORT=8080

# --- SECRETS & SECURITE (A CHANGER EN PRODUCTION) ---
APP_SECRET_KEY=generate_your_secure_random_key_here_minimum_32_chars
COOKIE_SECURE=true
SESSION_TIMEOUT_MINUTES=120

# --- INTEGRATIONS TIERCES ---
# Compte Google Agenda & Gmail associe par defaut
DEFAULT_GOOGLE_EMAIL=sebastien.pro@gmail.com
GOOGLE_CALENDAR_ENABLED=true

# Service de Navigation GPS Waze
WAZE_NAVIGATION_ENABLED=true
WAZE_BASE_URL=https://waze.com/ul

# --- STOCKAGE ET PERSISTANCE ---
# Repertoire de montage persistant pour les sauvegardes et exports
DATA_VOLUME_PATH=./data
LOGS_VOLUME_PATH=./docker/logs

# --- REVERSE PROXY NGINX RATE LIMITING ---
RATE_LIMIT_REQUESTS_PER_SECOND=20
RATE_LIMIT_BURST=40

# --- AUTOMATISATION DES SAUVEGARDES & STOCKAGE DISTANT (S3 / GCS / REMOTE) ---
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PROVIDER=local
S3_BUCKET_NAME=rdv-hub-backups-vault
S3_REGION=eu-west-3
S3_ENDPOINT_URL=https://s3.eu-west-3.amazonaws.com
S3_ACCESS_KEY=your_aws_s3_access_key
S3_SECRET_KEY=your_aws_s3_secret_key
GCS_BUCKET_NAME=rdv-hub-gcs-vault
GCS_CREDENTIALS_FILE=./secrets/gcs-service-account.json
REMOTE_BACKUP_SERVER=backup-vault.entreprise.com
REMOTE_BACKUP_USER=backup_user
REMOTE_BACKUP_PATH=/var/backups/rdv_hub
CRON_BACKUP_SCHEDULE="0 2 * * *"

# --- CLOUD SUPABASE (POSTGRESQL & AUTHENTICATION) ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_cle_publique_anon_supabase

